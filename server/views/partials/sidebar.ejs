<%
function initialsOf(name) {
  return (name || "")
    .split(/\s+/)
    .map(function (w) { return w.charAt(0); })
    .join("")
    .slice(0, 2)
    .toUpperCase();
}

const ICONS = {
  home: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
  calendar: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
  schedule: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
  user: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
  logout: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>`,
};

const NAV_ITEMS_CSDL = [
  { path: "/csdl/dashboard", label: "Home", icon: ICONS.home },
  { path: "/csdl/duty-management", label: "Duty Management", icon: ICONS.calendar },
  { path: "/csdl/schedule", label: "Schedule", icon: ICONS.schedule },
  { path: "/csdl/profile", label: "Profile &amp; Settings", icon: ICONS.user },
];
%>

<aside class="sidebar" id="sidebar">
  <div class="sidebar-brand text-center py-4 px-3">
    <img src="/img/logo.png" alt="HK Scholastics logo" class="sidebar-logo mb-2" width="72" height="72">
    <div class="sidebar-title">HK DUTY<br><span class="fw-light">SCHEDULE</span></div>
  </div>

  <nav class="sidebar-nav flex-grow-1 px-2">
    <% NAV_ITEMS_CSDL.forEach(function (item) { %>
    <a class="nav-item-link<%= item.path === activePath ? " active" : "" %>"
       href="<%= item.path %>"
       <%= item.path === activePath ? 'aria-current="page"' : "" %>>
      <span class="nav-icon" aria-hidden="true"><%- item.icon %></span>
      <span class="nav-label"><%- item.label %></span>
    </a>
    <% }); %>
  </nav>

  <div class="sidebar-footer p-3 border-top">
    <form method="post" action="/logout" class="d-flex align-items-center">
      <input type="hidden" name="_csrf" value="<%- csrfToken %>">
      <button class="nav-item-link d-flex align-items-center w-100" type="submit">
        <span class="nav-icon" aria-hidden="true"><%- ICONS.logout %></span>
        <span class="nav-label">Logout</span>
      </button>
    </form>
  </div>
</aside>
