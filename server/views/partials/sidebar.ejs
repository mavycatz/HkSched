<%
function initialsOf(name) {
  return (name || "")
    .split(/\s+/)
    .map(function (w) { return w.charAt(0); })
    .join("")
    .slice(0, 2)
    .toUpperCase();
}

const ICONS = {
  home: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
  calendarCheck: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><polyline points="8 10 12 14 16 10"/></svg>`,
  calendarGrid: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
  clipboard: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><polyline points="10 17 15 12 10 7"/><line x1="7" y1="21" x2="13" y2="21"/></svg>`,
  user: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
  logout: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>`,
  person: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
  bell: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>`,
  search: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>`,
};

function iconFor(path) {
  const map = {
    "/csdl/dashboard": ICONS.home,
    "/csdl/duty-management": ICONS.calendarCheck,
    "/csdl/schedule": ICONS.calendarGrid,
    "/csdl/applications": ICONS.clipboard,
    "/csdl/profile": ICONS.user,
  };
  return map[path] || ICONS.user;
}
%>

<aside class="csdl-sidebar" id="csdl-sidebar">
  <div class="csdl-sidebar-brand">
    <img class="csdl-sidebar-logo" src="/img/logo.png" alt="HK Scholastics logo">
    <h1 class="csdl-sidebar-title">HK DUTY<br>SCHEDULE</h1>
  </div>

  <ul class="csdl-nav" aria-label="Main navigation">
    <% nav.forEach(function (item) { %>
    <li class="csdl-nav-item">
      <a class="csdl-nav-link<%= item.path === activePath ? " active" : "" %>"
         href="<%= item.path %>"
         <%= item.path === activePath ? 'aria-current="page"' : "" %>>
        <span class="csdl-nav-icon" aria-hidden="true"><%- iconFor(item.path) %></span>
        <span><%= item.label %></span>
      </a>
    </li>
    <% }); %>
  </ul>

  <div class="csdl-sidebar-footer">
    <form method="post" action="/logout" class="csdl-logout-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="csdl-nav-link" type="submit">
        <span class="csdl-nav-icon" aria-hidden="true"><%- ICONS.logout %></span>
        <span>Logout</span>
      </button>
    </form>
  </div>
</aside>
