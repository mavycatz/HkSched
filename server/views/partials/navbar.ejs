<%
function initialsOf(name) {
  return (name || "")
    .split(/\s+/)
    .map(function (w) { return w.charAt(0); })
    .join("")
    .slice(0, 2)
    .toUpperCase();
}

const ICONS = {
  search: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>`,
  bell: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>`,
  person: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
};
%>

<header class="csdl-navbar" id="csdl-navbar">
  <div class="csdl-search">
    <svg class="csdl-search-icon" aria-hidden="true" focusable="false"><%- ICONS.search %></svg>
    <input type="text" class="csdl-search-input" placeholder="Search" autocomplete="off">
  </div>

  <div class="csdl-navbar-right">
    <div class="csdl-bell-wrap">
      <svg class="csdl-bell" aria-hidden="true" focusable="false"><%- ICONS.bell %></svg>
      <span class="csdl-notification-dot" id="csdl-notification-dot" aria-hidden="true"></span>
    </div>

    <div class="csdl-user-block" id="csdl-user-block" role="button" tabindex="0" aria-haspopup="true" aria-expanded="false">
      <div class="csdl-avatar"><%= initialsOf(user.full_name) %></div>
      <div class="csdl-user-info">
        <p class="csdl-user-name"><%= user.full_name %></p>
        <p class="csdl-user-role">CSDL Staff</p>
      </div>
    </div>
  </div>
</header>

<div class="csdl-dropdown" id="csdl-notification-dropdown" role="menu" aria-hidden="true">
  <p class="csdl-dropdown-empty">No notifications</p>
</div>

<div class="csdl-dropdown" id="csdl-user-dropdown" role="menu" aria-hidden="true">
  <a class="csdl-dropdown-item" href="/csdl/profile">Profile &amp; Settings</a>
  <form method="post" action="/logout" class="csdl-dropdown-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="csdl-dropdown-item" type="submit">Logout</button>
  </form>
</div>
