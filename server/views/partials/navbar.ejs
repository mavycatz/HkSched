<nav class="navbar" id="top-navbar">
  <div class="container-fluid">
    <!-- Mobile drawer toggle (shown below the lg breakpoint) -->
    <button class="mobile-menu-btn" id="drawer-toggle" type="button"
            aria-label="Open navigation menu" aria-expanded="false" aria-controls="sidebar">
      <%- include("drawer-toggle") %>
    </button>

    <!-- Search field (left): one flat pill input with the icon inside it -->
    <div class="search-wrapper me-auto">
      <i class="bi bi-search search-icon" aria-hidden="true"></i>
      <input type="text" class="search-input" placeholder="Search" aria-label="Search" autocomplete="off">
    </div>

    <!-- Right: bell + user block -->
    <div class="d-flex align-items-center gap-3">
      <!-- Notification bell -->
      <div class="nav-item dropdown position-relative">
        <a class="nav-link p-0 text-decoration-none" href="#" id="bellDropdown" role="button" aria-expanded="false" aria-label="Notifications">
          <i class="bi bi-bell fs-5 text-navy"></i>
          <span class="notification-dot" id="notificationDot" aria-hidden="true"></span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end p-2" id="bellDropdown-menu" hidden aria-labelledby="bellDropdown">
          <li><p class="dropdown-item-text text-muted small m-0">No notifications</p></li>
        </ul>
      </div>

      <!-- Profile block (avatar + name + role, laid out horizontally) -->
      <div class="nav-item dropdown position-relative">
        <a class="nav-link profile-block d-flex align-items-center flex-nowrap text-decoration-none" href="#" id="userDropdown" role="button" aria-expanded="false">
          <span class="user-avatar flex-shrink-0"><i class="bi bi-person" aria-hidden="true"></i></span>
          <% if (typeof user !== "undefined" && user) { %>
          <span class="user-info d-flex align-items-center flex-nowrap">
            <span class="user-name fw-semibold text-truncate"><%= user.full_name %></span>
            <span class="user-role flex-shrink-0"><%= user.role === "CSDL" ? "CSDL Staff" : user.role %></span>
          </span>
          <% } %>
        </a>
        <ul class="dropdown-menu dropdown-menu-end" id="userDropdown-menu" hidden aria-labelledby="userDropdown">
          <li><a class="dropdown-item" href="/csdl/profile">Profile &amp; Settings</a></li>
        </ul>
      </div>
    </div>
  </div>
</nav>
