<%
function initialsOf(name) {
  return (name || "")
    .split(/\s+/)
    .map(function (w) { return w.charAt(0); })
    .join("")
    .slice(0, 2)
    .toUpperCase();
}
%>

<nav class="navbar" id="top-navbar">
  <div class="container-fluid px-3">
    <!-- Search field -->
    <div class="search-wrapper me-auto">
      <div class="input-group">
        <span class="input-group-text bg-light border-0">
          <i class="bi bi-search text-muted"></i>
        </span>
        <input type="text" class="form-control form-control-sm border-0 bg-light" placeholder="Search" autocomplete="off">
      </div>
    </div>

    <!-- Right side: notification + user -->
    <div class="d-flex align-items-center gap-3">
      <!-- Notification bell -->
      <div class="nav-item dropdown">
        <a class="nav-link p-0 text-decoration-none" href="#" id="bellDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications">
          <i class="bi bi-bell fs-5 text-navy"></i>
          <span class="notification-dot" id="notificationDot" aria-hidden="true"></span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end p-2" aria-labelledby="bellDropdown">
          <li><p class="dropdown-item-text text-muted small m-0">No notifications</p></li>
        </ul>
      </div>

      <!-- User profile dropdown -->
      <div class="nav-item dropdown">
        <a class="nav-link d-flex align-items-center text-decoration-none" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
          <div class="user-avatar me-2">
            <i class="bi bi-person fs-4"></i>
          </div>
          <div class="user-info d-none d-md-block">
            <div class="user-name fw-semibold"><%= user.full_name %></div>
            <div class="user-role text-truncate" style="max-width: 140px;">CSDL Staff</div>
          </div>
        </a>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
          <li><a class="dropdown-item" href="/csdl/profile">Profile &amp; Settings</a></li>
          <li><hr class="dropdown-divider"></li>
          <li>
            <form method="post" action="/logout" class="m-0">
              <input type="hidden" name="_csrf" value="<%- csrfToken %>">
              <button class="dropdown-item text-danger" type="submit">Logout</button>
            </form>
          </li>
        </ul>
      </div>
    </div>
  </div>
</nav>
