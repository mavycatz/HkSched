<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== "undefined" && title ? title + " · HK Scholastics" : "HK Scholastics" %></title>
  <%# Vendor assets are self-hosted so they load under the strict CSP (style-src 'self'). %>
  <%# The version parameter busts the browser cache whenever an asset changes. %>
  <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css?v=<%= typeof assetVersion !== "undefined" ? assetVersion : "0" %>">
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css?v=<%= typeof assetVersion !== "undefined" ? assetVersion : "0" %>">
  <link rel="stylesheet" href="/css/theme.css?v=<%= typeof assetVersion !== "undefined" ? assetVersion : "0" %>">
  <%# Page-specific stylesheets, loaded after the shared theme so they can override it. %>
  <% if (typeof pageStyles !== "undefined" && Array.isArray(pageStyles)) { %>
  <% pageStyles.forEach(function (name) { %>
  <link rel="stylesheet" href="/css/pages/<%= name %>.css?v=<%= typeof assetVersion !== "undefined" ? assetVersion : "0" %>">
  <% }); %>
  <% } %>
</head>
<body class="<%= typeof bodyClass !== "undefined" ? bodyClass : "" %>">
