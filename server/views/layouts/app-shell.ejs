<%- include("../partials/head", { title: title, bodyClass: bodyClass, pageStyles: typeof pageStyles !== "undefined" ? pageStyles : undefined }) %>
<div class="app-wrapper d-flex min-vh-100">
  <%- include("../partials/sidebar", { user, nav, activePath, csrfToken }) %>

  <div class="main-content flex-grow-1 d-flex flex-column">
    <%- include("../partials/navbar", { user, csrfToken }) %>

    <main class="content flex-grow-1">
      <%- include(contentPartial, Object.assign({}, contentLocals || {})) %>
    </main>
  </div>

  <div class="sidebar-overlay" id="backdrop"></div>
</div>

<script src="/vendor/bootstrap/js/bootstrap.bundle.min.js?v=<%= typeof assetVersion !== "undefined" ? assetVersion : "0" %>"></script>
<script src="/js/shell.js?v=<%= typeof assetVersion !== "undefined" ? assetVersion : "0" %>" defer></script>
<%# Page-specific scripts: one owner per page, loaded after the shared shell. %>
<% if (typeof pageScripts !== "undefined" && Array.isArray(pageScripts)) { %>
<% pageScripts.forEach(function (name) { %>
<script src="/js/<%= name %>.js?v=<%= typeof assetVersion !== "undefined" ? assetVersion : "0" %>" defer></script>
<% }); %>
<% } %>
</body>
</html>
