<%- include("../partials/head", { title, bodyClass }) %>
<div class="app-wrapper d-flex min-vh-100">
  <!-- Fixed left sidebar -->
  <aside class="sidebar" id="sidebar">
    <%- include("../partials/sidebar", { user, nav, activePath, csrfToken }) %>
  </aside>

  <!-- Main content area -->
  <div class="main-content flex-grow-1 d-flex flex-column">
    <nav class="navbar" id="top-navbar">
      <%- include("../partials/navbar", { user, csrfToken }) %>
    </nav>

    <main class="content flex-grow-1 p-0">
      <%- include(contentPartial, contentLocals || {}) %>
    </main>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
<script src="/js/shell.js" defer></script>
</body>
</html>
