<div class="app-stack">

  <header class="page-header">
    <h1 class="page-title">Applications</h1>
    <p class="page-subtitle">Manage duty applications with status tabs, approvals, rejections, and notifications.</p>
  </header>

  <!-- The status tabs, the same segmented control the dashboard's date filter uses. -->
  <div class="app-panel">
    <div class="app-panel__body">
      <div class="app-segment" role="tablist" aria-label="Application status">
        <a class="app-segment__btn<%= tab === 'pending' ? ' app-segment__btn--active' : '' %>"
           href="?tab=pending" role="tab" aria-selected="<%= tab === 'pending' ? 'true' : 'false' %>">Pending</a>
        <a class="app-segment__btn<%= tab === 'approved' ? ' app-segment__btn--active' : '' %>"
           href="?tab=approved" role="tab" aria-selected="<%= tab === 'approved' ? 'true' : 'false' %>">Approved</a>
        <a class="app-segment__btn<%= tab === 'rejected' ? ' app-segment__btn--active' : '' %>"
           href="?tab=rejected" role="tab" aria-selected="<%= tab === 'rejected' ? 'true' : 'false' %>">Rejected</a>
        <a class="app-segment__btn<%= tab === 'all' ? ' app-segment__btn--active' : '' %>"
           href="?tab=all" role="tab" aria-selected="<%= tab === 'all' ? 'true' : 'false' %>">All</a>
      </div>
    </div>
  </div>

  <div class="app-panel">
    <div class="app-panel__head">
      <div class="app-panel__titles">
        <h2 class="app-panel__title">Duty applications</h2>
        <p class="app-panel__note">Students and teachers applying for a duty, and what was decided.</p>
      </div>
    </div>
    <div class="app-panel__body app-panel__body--flush">
      <div id="app-loading" class="app-empty">
        <span class="app-empty__icon" aria-hidden="true"><i class="bi bi-arrow-repeat"></i></span>
        <p class="app-empty__text">Loading applications...</p>
      </div>
      <div id="app-empty" class="app-empty d-none">
        <span class="app-empty__icon" aria-hidden="true"><i class="bi bi-inbox"></i></span>
        <div class="app-empty__title">No applications</div>
        <p class="app-empty__text">There are no applications in this tab.</p>
      </div>
      <div class="app-table-wrap" id="app-table-wrap">
        <table class="app-table">
          <thead>
            <tr>
              <th>Applicant</th>
              <th>Duty</th>
              <th>Date</th>
              <th>Message</th>
              <th>Status</th>
              <th class="app-table__actions">Actions</th>
            </tr>
          </thead>
          <tbody id="app-tbody"></tbody>
        </table>
      </div>
    </div>
  </div>

</div>

<!-- Reviewing an application -->
<div class="modal fade app-modal" id="reviewModal" tabindex="-1" aria-labelledby="review-modal-label" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <span class="app-modal__icon" aria-hidden="true"><i class="bi bi-file-earmark-check"></i></span>
        <div class="app-modal__heading">
          <h2 class="modal-title" id="review-modal-label">Review application</h2>
          <p class="app-modal__note">Approve the application to assign the duty, or reject it with a note.</p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="review-app-id">
        <div class="app-form-field">
          <label class="app-label" for="review-note">Note (optional)</label>
          <textarea class="app-input" id="review-note" rows="3"></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="app-btn app-btn--ghost" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="app-btn app-btn--danger" id="btn-reject">Reject</button>
        <button type="button" class="app-btn app-btn--success" id="btn-approve">Approve</button>
      </div>
    </div>
  </div>
</div>

<%# The page's data travels as a JSON block: it is read by the page's own
    script, and the strict CSP only allows scripts from this origin. %>
<script type="application/json" id="app-data"><%- jsonForScript({ apps: apps || [], tab: tab, role: user.role }) %></script>
