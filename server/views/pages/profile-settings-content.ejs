<div class="app-stack">

  <header class="page-header">
    <h1 class="page-title">Profile & Settings</h1>
    <p class="page-subtitle">Edit your name, contact info, password, and notification preferences.</p>
  </header>

  <div class="app-panel">
    <div class="app-panel__head">
      <div class="app-panel__titles">
        <h2 class="app-panel__title">Personal information</h2>
        <p class="app-panel__note">How your name and contact details appear to the rest of the school.</p>
      </div>
    </div>
    <div class="app-panel__body">
      <form id="ps-form">
        <div class="app-form-grid">
          <div class="app-form-field">
            <label class="app-label" for="ps-name">Full name</label>
            <input class="app-input" id="ps-name" name="name" value="<%= profile.name || '' %>" autocomplete="off">
          </div>
          <div class="app-form-field">
            <label class="app-label" for="ps-email">Email</label>
            <input class="app-input" type="email" id="ps-email" name="email" value="<%= profile.email || '' %>" autocomplete="off">
          </div>
          <div class="app-form-field">
            <label class="app-label" for="ps-phone">Phone</label>
            <input class="app-input" id="ps-phone" name="phone" value="<%= profile.phone || '' %>" autocomplete="off">
          </div>
        </div>
        <div class="app-toolbar__actions">
          <button class="app-btn app-btn--primary" type="submit">Save profile</button>
        </div>
        <p class="app-msg" id="ps-msg" role="status"></p>
      </form>
    </div>
  </div>

  <div class="app-panel">
    <div class="app-panel__head">
      <div class="app-panel__titles">
        <h2 class="app-panel__title">Notification preferences</h2>
        <p class="app-panel__note">How you want to hear about your duties.</p>
      </div>
    </div>
    <div class="app-panel__body">
      <form id="np-form">
        <div class="app-form-field">
          <label class="app-check" for="np-email">
            <input type="checkbox" id="np-email" name="email" <%= profile.notification_preferences?.email ? 'checked' : '' %>>
            <span>Email notifications</span>
          </label>
        </div>
        <div class="app-form-field">
          <label class="app-check" for="np-inapp">
            <input type="checkbox" id="np-inapp" name="in_app" <%= profile.notification_preferences?.in_app ? 'checked' : '' %>>
            <span>In-app notifications</span>
          </label>
        </div>
        <div class="app-toolbar__actions">
          <button class="app-btn app-btn--primary" type="submit">Save preferences</button>
        </div>
        <p class="app-msg" id="np-msg" role="status"></p>
      </form>
    </div>
  </div>

  <div class="app-panel">
    <div class="app-panel__head">
      <div class="app-panel__titles">
        <h2 class="app-panel__title">Change password</h2>
        <p class="app-panel__note">Pick a new password of at least eight characters.</p>
      </div>
    </div>
    <div class="app-panel__body">
      <form id="cp-form">
        <div class="app-form-grid">
          <div class="app-form-field">
            <label class="app-label" for="cp-current">Current password</label>
            <input class="app-input" type="password" id="cp-current" name="current_password" autocomplete="current-password" required>
          </div>
          <div class="app-form-field">
            <label class="app-label" for="cp-new">New password</label>
            <input class="app-input" type="password" id="cp-new" name="new_password" autocomplete="new-password" minlength="8" required>
          </div>
          <div class="app-form-field">
            <label class="app-label" for="cp-confirm">Confirm new password</label>
            <input class="app-input" type="password" id="cp-confirm" name="confirm_password" autocomplete="new-password" minlength="8" required>
          </div>
        </div>
        <div class="app-toolbar__actions">
          <button class="app-btn app-btn--primary" type="submit">Change password</button>
        </div>
        <p class="app-msg" id="cp-msg" role="status"></p>
      </form>
    </div>
  </div>

</div>
