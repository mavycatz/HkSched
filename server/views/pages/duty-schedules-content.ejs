<section class="page-header">
  <h1 class="page-title">Duty Schedules</h1>
  <p class="page-subtitle">Browse duty slots with filters by date, class, and person. Click a duty for details.</p>
</section>

<section class="card mb-3">
  <div class="card-body">
    <form class="row g-2 align-items-end" id="ds-filter-form">
      <div class="col-12 col-md-3">
        <label class="form-label">Date</label>
        <input type="date" class="form-control" name="date" value="<%= filters.date || '' %>">
      </div>
      <div class="col-12 col-md-3">
        <label class="form-label">From</label>
        <input type="date" class="form-control" name="from" value="<%= filters.from || '' %>">
      </div>
      <div class="col-12 col-md-3">
        <label class="form-label">To</label>
        <input type="date" class="form-control" name="to" value="<%= filters.to || '' %>">
      </div>
      <div class="col-12 col-md-3">
        <label class="form-label">Class/Group</label>
        <input type="text" class="form-control" name="class" placeholder="e.g. Grade 10" value="<%= filters.class || '' %>">
      </div>
      <div class="col-12 col-md-3">
        <label class="form-label">Person</label>
        <input type="text" class="form-control" name="person" placeholder="Name or ID" value="<%= filters.person || '' %>">
      </div>
      <div class="col-12 col-md-3">
        <label class="form-label">Search</label>
        <input type="text" class="form-control" name="q" placeholder="Title, area..." value="<%= filters.q || '' %>">
      </div>
      <div class="col-12 col-md-6 d-flex gap-2">
        <button class="btn btn-primary" type="submit">Apply Filters</button>
        <a class="btn btn-outline-secondary" href="/duty-schedules">Clear</a>
      </div>
    </form>
  </div>
</section>

<section class="card">
  <div class="card-body">
    <div id="ds-loading" class="state-block">
      <div class="spinner-border text-primary" role="status"></div>
      <div class="state-text">Loading schedules...</div>
    </div>
    <div id="ds-empty" class="state-block d-none">
      <div class="state-icon"><i class="bi bi-calendar"></i></div>
      <div class="state-title">No duty schedules found</div>
      <div class="state-text">Try adjusting your filters.</div>
    </div>
    <div id="ds-list" class="list-group" style="display:none"></div>
  </div>
</section>

<div class="modal fade" id="dutyDetailModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Duty Details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="dd-content"></div>
      </div>
    </div>
  </div>
</div>

<script>
  window.__DS__ = { slots: <%- JSON.stringify(slots || []) %> };
</script>
