<section class="page-header">
  <h1 class="page-title">Create/Edit Schedule</h1>
  <p class="page-subtitle">Create, edit, and delete duty slots. Conflicts are validated before saving.</p>
</section>

<div class="row g-3">
  <div class="col-12 col-lg-5">
    <section class="card">
      <div class="card-body">
        <h5 class="mb-3">Duty Slot Form</h5>
        <form id="ces-form">
          <input type="hidden" name="id" id="ces-id">
          <div class="mb-2">
            <label class="form-label">Title *</label>
            <input class="form-control" name="title" required>
          </div>
          <div class="mb-2">
            <label class="form-label">Area/Location *</label>
            <input class="form-control" name="area" required>
          </div>
          <div class="mb-2">
            <label class="form-label">Description</label>
            <textarea class="form-control" name="description" rows="2"></textarea>
          </div>
          <div class="row g-2">
            <div class="col-6">
              <label class="form-label">Start Time *</label>
              <input type="datetime-local" class="form-control" name="start_time" required>
            </div>
            <div class="col-6">
              <label class="form-label">End Time</label>
              <input type="datetime-local" class="form-control" name="end_time">
            </div>
          </div>
          <div class="row g-2 mt-1">
            <div class="col-6">
              <label class="form-label">Required Headcount</label>
              <input type="number" class="form-control" name="required_headcount" value="1" min="1">
            </div>
            <div class="col-6">
              <label class="form-label">Class/Group</label>
              <input class="form-control" name="class_group">
            </div>
          </div>
          <div class="mb-2 mt-2">
            <label class="form-label">Status</label>
            <select class="form-select" name="status">
              <option value="pending">Pending</option>
              <option value="ongoing">Ongoing</option>
              <option value="completed">Completed</option>
              <option value="missed">Missed</option>
            </select>
          </div>
          <div class="d-flex gap-2 mt-3">
            <button class="btn btn-primary" type="submit">Save</button>
            <button class="btn btn-outline-secondary" type="button" id="ces-reset">New Slot</button>
            <button class="btn btn-outline-danger d-none" type="button" id="ces-delete">Delete</button>
          </div>
          <div id="ces-msg" class="mt-2 small"></div>
        </form>
      </div>
    </section>
  </div>
  <div class="col-12 col-lg-7">
    <section class="card">
      <div class="card-body">
        <h5 class="mb-3">Existing Duty Slots</h5>
        <div id="ces-loading" class="state-block">
          <div class="spinner-border text-primary" role="status"></div>
          <div class="state-text">Loading slots...</div>
        </div>
        <div id="ces-empty" class="state-block d-none">
          <div class="state-icon"><i class="bi bi-calendar-plus"></i></div>
          <div class="state-title">No duty slots yet</div>
          <div class="state-text">Create your first duty slot using the form.</div>
        </div>
        <div class="list-group" id="ces-list" style="display:none"></div>
      </div>
    </section>
  </div>
</div>

<script>
  window.__CES__ = { slots: <%- JSON.stringify(slots || []) %> };
</script>
