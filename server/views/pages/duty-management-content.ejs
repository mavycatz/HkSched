<%
  /* ---------------------------------------------------------------------------
     The Duty Management page: where schedules are written and where the
     location catalogue is kept. The list of every schedule lives on the Duty
     Schedules page, which is linked from here.
     --------------------------------------------------------------------------- */
%>

<div class="app-stack">

  <% if (message) { %>
  <div class="app-alert" role="status">
    <i class="bi bi-check-circle" aria-hidden="true"></i>
    <% if (message === "created") { %>The schedule was created.
    <% } else if (message === "updated") { %>The schedule was updated.
    <% } else if (message === "deleted") { %>The schedule was deleted.
    <% } else if (message === "cancelled") { %>The schedule was cancelled.
    <% } else if (message === "assigned") { %>The assignments were saved.
    <% } else if (message === "location-added") { %>The location was added to the catalogue.
    <% } else { %>Done.
    <% } %>
  </div>
  <% } %>

  <header class="page-header page-header--row">
    <div>
      <h1 class="page-title">Duty Management</h1>
      <p class="page-subtitle">Write the schedules and keep the places they are held in order.</p>
    </div>
    <div class="page-header__actions">
      <a class="app-btn app-btn--primary" href="/csdl/duty-management?create=1#duty-create-modal"
         data-bs-toggle="modal" data-bs-target="#duty-create-modal" id="dm-create-btn">
        <i class="bi bi-plus-lg" aria-hidden="true"></i>
        <span>Create schedule</span>
      </a>
      <a class="app-btn app-btn--quiet" href="/csdl/schedule" id="dm-go-browser">
        <i class="bi bi-list-ul" aria-hidden="true"></i>
        <span>See every schedule</span>
      </a>
    </div>
  </header>

  <!-- The location catalogue -->
  <section class="app-panel" id="dm-locations">
    <div class="app-panel__head">
      <h2 class="app-panel__title"><i class="bi bi-geo-alt" aria-hidden="true"></i> Locations</h2>
      <p class="app-panel__note">The places a schedule can be held in.</p>
    </div>
    <div class="app-panel__body">
      <% if (locationNotice && locationNotice.kind === "duplicate") { %>
      <div class="app-alert app-alert--warn" role="alert" id="dm-location-duplicate">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
        <% if (locationNotice.name) { %>
        "<%= locationNotice.name %>" is already in the catalogue. Use the one that is there.
        <% } else { %>
        That location could not be added. Give it a name and choose its kind.
        <% } %>
      </div>
      <% } %>

      <% if (locations.length === 0) { %>
      <p class="app-empty__text" id="dm-no-locations">No location is in the catalogue yet. Add the first one below.</p>
      <% } else { %>
      <ul class="dm-location-list" id="dm-location-list">
        <% locations.forEach(function (location) { %>
        <li class="dm-location">
          <span class="dm-location__name"><%= location.name %></span>
          <span class="badge badge--neutral"><%= location.kind %></span>
          <% if (location.building) { %><span class="dm-location__building"><%= location.building %></span><% } %>
          <% if (!location.is_active) { %><span class="badge badge--muted">Out of circulation</span><% } %>
        </li>
        <% }); %>
      </ul>
      <% } %>

      <% if (canManageLocations) { %>
      <form class="app-form app-form--inline" method="post" action="/csdl/duty-management/locations" id="dm-location-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="app-field app-field--grow">
          <label class="app-label" for="dm-location-name">Add a location</label>
          <input class="app-input" type="text" id="dm-location-name" name="name" placeholder="Name" required>
        </div>
        <div class="app-field">
          <label class="app-label" for="dm-location-kind">Kind</label>
          <select class="app-input app-select" id="dm-location-kind" name="kind">
            <option value="classroom">Classroom</option>
            <option value="office">Office</option>
            <option value="laboratory">Laboratory</option>
            <option value="facility">Facility</option>
            <option value="area">Area</option>
          </select>
        </div>
        <div class="app-field">
          <label class="app-label" for="dm-location-building">Building</label>
          <input class="app-input" type="text" id="dm-location-building" name="building" placeholder="Optional">
        </div>
        <div class="app-field app-field--action">
          <button class="app-btn app-btn--navy" type="submit" id="dm-location-submit">Add location</button>
        </div>
      </form>
      <% } %>
    </div>
  </section>
</div>

<%- include("./partials/duty-modals") %>
