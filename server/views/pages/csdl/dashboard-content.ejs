<!-- Dashboard greeting -->
<div class="greeting-row">
  <div class="greeting">
    <h1 class="dashboard-greeting fw-bold"><%= greeting %>, <%= displayName %>!</h1>
    <p class="greeting-subtitle mb-0">Here's your duty summary for today</p>
  </div>
  <div class="text-end">
    <p class="today-date fw-medium mb-0"><%= todayDate %></p>
  </div>
</div>

<!-- Summary stat cards -->
<div class="stats-grid mb-4">
  <a class="stat-card stat-blue" href="/csdl/duty-management">
    <div class="stat-icon-tile"><i class="bi bi-people"></i></div>
    <p class="stat-label">Total Students</p>
    <p class="stat-number"><%= totals.students %></p>
  </a>
  <a class="stat-card stat-green" href="/csdl/duty-management">
    <div class="stat-icon-tile"><i class="bi bi-check-circle"></i></div>
    <p class="stat-label">Completed Duties</p>
    <p class="stat-number"><%= totals.completed %></p>
  </a>
  <a class="stat-card stat-amber" href="/csdl/duty-management">
    <div class="stat-icon-tile"><i class="bi bi-clock"></i></div>
    <p class="stat-label">Ongoing Duties</p>
    <p class="stat-number"><%= totals.ongoing %></p>
  </a>
  <a class="stat-card stat-purple" href="/csdl/schedule">
    <div class="stat-icon-tile"><i class="bi bi-card-text"></i></div>
    <p class="stat-label">Total Assignments</p>
    <p class="stat-number"><%= totals.assignments %></p>
  </a>
</div>

<!-- Needs attention row -->
<div class="stats-grid mb-4">
  <a class="stat-card stat-orange" href="/csdl/applications">
    <div class="stat-icon-tile"><i class="bi bi-file-earmark-person"></i></div>
    <p class="stat-label">Pending Applications</p>
    <p class="stat-number"><%= totals.pendingApplications %></p>
  </a>
  <a class="stat-card stat-red" href="/csdl/duty-management">
    <div class="stat-icon-tile"><i class="bi bi-exclamation-triangle"></i></div>
    <p class="stat-label">Missed Duties</p>
    <p class="stat-number"><%= totals.missed %></p>
  </a>
</div>

<!-- Today's Assignments -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-white border-bottom py-3">
    <div class="d-flex justify-content-between align-items-center">
      <h5 class="section-title mb-0">Today's Assignment</h5>
      <a href="/csdl/duty-management" class="view-all">View all</a>
    </div>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th class="border-0 fw-medium small text-navy">Date</th>
            <th class="border-0 fw-medium small text-navy">Time</th>
            <th class="border-0 fw-medium small text-navy">Area</th>
            <th class="border-0 fw-medium small text-navy">Tasks</th>
            <th class="border-0 fw-medium small text-navy text-end">Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (assignmentsToday && assignmentsToday.length > 0) { %>
            <% assignmentsToday.forEach(function (a) { %>
            <tr>
              <td class="small"><%= a.date %></td>
              <td class="small"><%= a.time %></td>
              <td class="small"><%= a.area %></td>
              <td class="small"><%= a.tasks %></td>
              <td class="text-end small">
                <span class="badge badge-bg-<%= a.status.toLowerCase() %>"><%= a.status %></span>
              </td>
            </tr>
            <% }); %>
          <% } else { %>
          <tr>
            <td colspan="5" class="text-center py-5">
              <div class="empty-state">
                <i class="bi bi-calendar-x fs-1 text-muted mb-3"></i>
                <p class="text-muted mb-0">No tasks for today</p>
              </div>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
