<!-- Dashboard greeting + date filter -->
<div class="greeting-row">
  <div class="greeting">
    <h1 class="dashboard-greeting fw-bold"><%= greeting %>, <%= displayName %>!</h1>
    <p class="greeting-subtitle mb-0">Here's your duty summary for <%= rangeLabel.toLowerCase() %></p>
  </div>
  <div class="range-filter d-flex align-items-center gap-2">
    <span class="range-label fw-medium text-navy small">Range:</span>
    <div class="range-segment">
      <a class="range-btn<%= rangeKey === "today" ? " active" : "" %>"
         href="/csdl/dashboard?range=today">Today</a>
      <a class="range-btn<%= rangeKey === "week" ? " active" : "" %>"
         href="/csdl/dashboard?range=week">This Week</a>
      <a class="range-btn<%= rangeKey === "month" ? " active" : "" %>"
         href="/csdl/dashboard?range=month">This Month</a>
      <a class="range-btn<%= rangeKey === "custom" ? " active" : "" %>"
         href="/csdl/dashboard?range=custom<%= rangeFrom ? "&from=" + rangeFrom : "" %><%= rangeTo ? "&to=" + rangeTo : "" %>">Custom</a>
    </div>
    <% if (rangeKey === "custom") { %>
    <form class="range-custom-form d-none" method="get" action="/csdl/dashboard">
      <input type="hidden" name="range" value="custom">
      <label class="range-label fw-medium text-navy small me-1">From</label>
      <input type="date" name="from" value="<%= rangeFrom %>" class="form-control form-control-sm range-date-input">
      <label class="range-label fw-medium text-navy small me-1 ms-2">To</label>
      <input type="date" name="to" value="<%= rangeTo %>" class="form-control form-control-sm range-date-input">
      <button type="submit" class="btn btn-sm btn-primary ms-2">Apply</button>
    </form>
    <% } %>
  </div>
</div>

<!-- Summary stat cards (4 only, same structure so the numbers line up) -->
<div class="stats-grid">
  <a class="stat-card stat-blue" href="/csdl/dashboard?range=<%= rangeKey %><%= rangeFrom ? "&from=" + rangeFrom : "" %><%= rangeTo ? "&to=" + rangeTo : "" %>">
    <div class="stat-icon-tile">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
    </div>
    <p class="stat-label">Total Students</p>
    <p class="stat-number"><%= totals.students %></p>
    <p class="stat-caption"><%= totals.students %> of <%= totals.studentsTotal %> students assigned</p>
  </a>
  <a class="stat-card stat-green" href="/csdl/dashboard?range=<%= rangeKey %><%= rangeFrom ? "&from=" + rangeFrom : "" %><%= rangeTo ? "&to=" + rangeTo : "" %>">
    <div class="stat-icon-tile">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <p class="stat-label">Completed</p>
    <p class="stat-number"><%= totals.completed %></p>
    <p class="stat-caption"><%= totals.completed %> of <%= totals.assignments %> completed</p>
  </a>
  <a class="stat-card stat-amber" href="/csdl/dashboard?range=<%= rangeKey %><%= rangeFrom ? "&from=" + rangeFrom : "" %><%= rangeTo ? "&to=" + rangeTo : "" %>">
    <div class="stat-icon-tile">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    </div>
    <p class="stat-label">Ongoing Duties</p>
    <p class="stat-number"><%= totals.ongoing %></p>
    <p class="stat-caption"><%= totals.ongoing %> of <%= totals.assignments %> ongoing</p>
  </a>
  <a class="stat-card stat-purple" href="/csdl/dashboard?range=<%= rangeKey %><%= rangeFrom ? "&from=" + rangeFrom : "" %><%= rangeTo ? "&to=" + rangeTo : "" %>">
    <div class="stat-icon-tile">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4l3 3m6-3a9 9 0 1 1-14 0c0-2.54-1.07-4.74 2.59-6.64"/></svg>
    </div>
    <p class="stat-label">Assignment</p>
    <p class="stat-number"><%= totals.assignments %></p>
    <p class="stat-caption"><%= totals.assignments %> duties in this period</p>
  </a>
</div>

<!-- Today's Assignment table (stretches across the content area) -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-white border-bottom py-3">
    <div class="d-flex justify-content-between align-items-center">
      <h5 class="section-title mb-0"><%= sectionTitle %></h5>
    </div>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th class="border-0 fw-medium small text-navy">Date</th>
            <th class="border-0 fw-medium small text-navy">Time</th>
            <th class="border-0 fw-medium small text-navy">Area</th>
            <th class="border-0 fw-medium small text-navy">Tasks</th>
            <th class="border-0 fw-medium small text-navy text-end">Status</th>
          </tr>
        </thead>
        <tbody id="assignments-table-body">
          <% if (assignmentsToday && assignmentsToday.length > 0) { %>
            <% assignmentsToday.forEach(function (a) { %>
            <tr>
              <td class="small"><%= a.date %></td>
              <td class="small"><%= a.time %></td>
              <td class="small"><%= a.area %></td>
              <td class="small"><%= a.tasks %></td>
              <td class="text-end small">
                <span class="status-badge status-badge--<%= a.status.toLowerCase() %>"><%= a.status %></span>
              </td>
            </tr>
            <% }); %>
          <% } else { %>
          <tr>
            <td colspan="5" class="text-center py-5">
              <div class="empty-state">
                <i class="bi bi-calendar-x fs-1 text-muted mb-3"></i>
                <p class="text-muted mb-0"><%= emptyMessage %></p>
              </div>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Skeleton placeholders (shown during JS fetch, hidden on initial server render) -->
<div id="dashboard-skeleton" class="d-none">
  <div class="skeleton-row">
    <div class="skeleton-col"></div>
    <div class="skeleton-col"></div>
    <div class="skeleton-col"></div>
    <div class="skeleton-col"></div>
  </div>
  <div class="skeleton-table"></div>
</div>
