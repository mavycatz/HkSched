<%- include("../partials/head", { title: "Dashboard", bodyClass: "csdl-page" }) %>
<div class="app-shell">
  <aside class="csdl-sidebar">
    <%- include("../partials/sidebar", { user: user, nav: nav, activePath: "/csdl/dashboard", csrfToken: csrfToken }) %>
  </aside>
  <div class="csdl-main">
    <header class="csdl-navbar">
      <%- include("../partials/navbar", { user: user, csrfToken: csrfToken }) %>
    </header>
    <main class="csdl-content">
      <div class="csdl-greeting-row">
        <div class="csdl-greeting">
          <h1 class="csdl-greeting-title"><%= greeting %>, <%= displayName %>!</h1>
          <p class="csdl-greeting-subtitle">Here's your duty summary for today</p>
        </div>
        <p class="csdl-today-date"><%= todayDate %></p>
      </div>

      <div class="csdl-stats-grid">
        <a class="csdl-stat-card csdl-stat-blue" href="/csdl/duty-management">
          <div class="csdl-stat-icon-tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>
          <p class="csdl-stat-label">Total Students</p>
          <p class="csdl-stat-number"><%= totals.students %></p>
        </a>
        <a class="csdl-stat-card csdl-stat-green" href="/csdl/duty-management">
          <div class="csdl-stat-icon-tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
          <p class="csdl-stat-label">Completed</p>
          <p class="csdl-stat-number"><%= totals.completed %></p>
        </a>
        <a class="csdl-stat-card csdl-stat-amber" href="/csdl/duty-management">
          <div class="csdl-stat-icon-tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
          <p class="csdl-stat-label">Ongoing Duties</p>
          <p class="csdl-stat-number"><%= totals.ongoing %></p>
        </a>
        <a class="csdl-stat-card csdl-stat-purple" href="/csdl/schedule">
          <div class="csdl-stat-icon-tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4l3 3m6-3a9 9 0 1 1-14 0c0-2.54-1.07-4.74 2.59-6.64"/></svg></div>
          <p class="csdl-stat-label">Assignment</p>
          <p class="csdl-stat-number"><%= totals.assignments %></p>
        </a>
        <a class="csdl-stat-card csdl-stat-orange" href="/csdl/applications">
          <div class="csdl-stat-icon-tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><polyline points="16 13 18 13 18 13"/></svg></div>
          <p class="csdl-stat-label">Pending Applications</p>
          <p class="csdl-stat-number"><%= totals.pendingApplications %></p>
        </a>
        <a class="csdl-stat-card csdl-stat-red" href="/csdl/duty-management">
          <div class="csdl-stat-icon-tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"/><polyline points="8 21 12 17 12 17 12 21"/></svg></div>
          <p class="csdl-stat-label">Missed Duties</p>
          <p class="csdl-stat-number"><%= totals.missed %></p>
        </a>
      </div>

      <div class="csdl-section">
        <div class="csdl-section-header">
          <h2 class="csdl-section-title">Today's Assignment</h2>
          <a class="csdl-view-all" href="/csdl/duty-management">View all</a>
        </div>
        <div class="csdl-table-card">
          <table class="csdl-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Time</th>
                <th>Area</th>
                <th>Tasks</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% if (assignmentsToday && assignmentsToday.length > 0) { %>
                <% assignmentsToday.forEach(function (a) { %>
                <tr>
                  <td><%= a.date %></td>
                  <td><%= a.time %></td>
                  <td><%= a.area %></td>
                  <td><%= a.tasks %></td>
                  <td><span class="csdl-badge csdl-badge-<%= a.status.toLowerCase() %>"><%= a.status %></span></td>
                </tr>
                <% }); %>
              <% } else { %>
              <tr>
                <td colspan="5">
                  <div class="csdl-empty-state">
                    <svg class="csdl-empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    <p class="csdl-empty-text">No tasks for today</p>
                  </div>
                </td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
</div>
<script src="/js/shell.js" defer></script>
</body>
</html>
