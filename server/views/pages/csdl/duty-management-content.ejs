<%
/* ---------------------------------------------------------------------------
   Helpers for this page. Everything is rendered server-side from the query
   string, so the page works without JavaScript.
   --------------------------------------------------------------------------- */
const STATUSES = ["ongoing", "completed", "pending", "missed"];

function buildUrl(overrides) {
  const params = new URLSearchParams();
  if (filters.status) params.set("status", filters.status);
  if (filters.search) params.set("q", filters.search);
  if (filters.from) params.set("from", filters.from);
  if (filters.to) params.set("to", filters.to);
  for (const key of Object.keys(overrides || {})) {
    const value = overrides[key];
    if (value === null || value === undefined || value === "") params.delete(key);
    else params.set(key, String(value));
  }
  const query = params.toString();
  return "/csdl/duty-management" + (query ? "?" + query : "");
}

const MANILA = "Asia/Manila";

function fmtDate(value) {
  if (!value) return "—";
  return new Date(value).toLocaleDateString("en-PH", {
    timeZone: MANILA, month: "short", day: "numeric", year: "numeric",
  });
}

function fmtTime(value) {
  if (!value) return "—";
  return new Date(value).toLocaleTimeString("en-PH", {
    timeZone: MANILA, hour: "2-digit", minute: "2-digit", hour12: true,
  });
}

function fmtDateTime(value) {
  if (!value) return "—";
  return fmtDate(value) + " · " + fmtTime(value);
}

/* A "YYYY-MM-DD" value for a day in the Manila calendar. */
function toDateValue(value) {
  if (!value) return "";
  const parts = new Intl.DateTimeFormat("en-CA", {
    timeZone: MANILA, year: "numeric", month: "2-digit", day: "2-digit",
  }).formatToParts(new Date(value));
  const get = (type) => (parts.find(function (p) { return p.type === type; }) || {}).value || "";
  return get("year") + "-" + get("month") + "-" + get("day");
}

/* A "YYYY-MM-DDTHH:mm" value for a datetime-local input, in Manila time. */
function toInputValue(value) {
  if (!value) return "";
  const parts = new Intl.DateTimeFormat("en-CA", {
    timeZone: MANILA, year: "numeric", month: "2-digit", day: "2-digit",
    hour: "2-digit", minute: "2-digit", hourCycle: "h23",
  }).formatToParts(new Date(value));
  const get = (type) => (parts.find(function (p) { return p.type === type; }) || {}).value || "";
  return get("year") + "-" + get("month") + "-" + get("day") + "T" + get("hour") + ":" + get("minute");
}

function titleCase(value) {
  const text = String(value || "");
  return text.charAt(0).toUpperCase() + text.slice(1);
}
%>

<!-- Page header -->
<div class="duty-page-head">
  <div>
    <h1 class="duty-page-title">Duty Management</h1>
    <p class="duty-page-subtitle">Review, filter and track duty schedules across all roles.</p>
  </div>
  <button type="button" class="btn btn-primary duty-create-btn" data-bs-toggle="modal"
          data-bs-target="#create-duty-modal">
    <i class="bi bi-plus-lg" aria-hidden="true"></i>
    New duty
  </button>
</div>

<!-- Status filter pills, each showing how many duties it would list -->
<div class="filter-pills" role="group" aria-label="Filter duties by status">
  <a class="filter-pill<%= filters.status ? "" : " active" %>" href="<%= buildUrl({ status: null, page: null }) %>"
     aria-current="<%= filters.status ? "false" : "true" %>">
    <span class="filter-pill-label">All</span>
    <span class="filter-pill-count"><%= counts.all %></span>
  </a>
  <% STATUSES.forEach(function (status) { %>
  <a class="filter-pill filter-pill--<%= status %><%= filters.status === status ? " active" : "" %>"
     href="<%= buildUrl({ status: status, page: null }) %>"
     aria-current="<%= filters.status === status ? "true" : "false" %>">
    <span class="filter-pill-label"><%= titleCase(status) %></span>
    <span class="filter-pill-count"><%= counts[status] %></span>
  </a>
  <% }); %>
</div>

<!-- Search and date filters on one aligned row -->
<form class="duty-filters" method="get" action="/csdl/duty-management" id="duty-filter-form">
  <% if (filters.status) { %>
  <input type="hidden" name="status" value="<%= filters.status %>">
  <% } %>
  <div class="duty-filter-field duty-filter-search">
    <label class="form-label" for="duty-search">Search</label>
    <div class="duty-search-input">
      <i class="bi bi-search" aria-hidden="true"></i>
      <input type="search" class="form-control" id="duty-search" name="q"
             value="<%= filters.search || "" %>" placeholder="Title, area or assignee">
    </div>
  </div>
  <div class="duty-filter-field">
    <label class="form-label" for="duty-from">From</label>
    <input type="date" class="form-control" id="duty-from" name="from" value="<%= filters.from || "" %>">
  </div>
  <div class="duty-filter-field">
    <label class="form-label" for="duty-to">To</label>
    <input type="date" class="form-control" id="duty-to" name="to" value="<%= filters.to || "" %>">
  </div>
  <div class="duty-filter-actions">
    <button type="submit" class="btn btn-primary">Apply</button>
    <% if (filters.status || filters.search || filters.from || filters.to) { %>
    <a class="btn btn-secondary" href="/csdl/duty-management" id="clear-duty-filters">Clear</a>
    <% } %>
  </div>
</form>

<!-- Duty cards -->
<% if (duties.length > 0) { %>
<div class="duty-grid">
  <% duties.forEach(function (duty) { %>
  <article class="duty-card duty-card--<%= duty.status %>" data-duty-id="<%= duty.id %>">
    <div class="duty-card-head">
      <h2 class="duty-card-title"><%= duty.title %></h2>
      <span class="status-badge status-badge--<%= duty.status %>"><%= titleCase(duty.status) %></span>
    </div>
    <dl class="duty-card-details">
      <div class="duty-detail">
        <dt class="duty-detail-label">Area</dt>
        <dd class="duty-detail-value"><%= duty.area %></dd>
      </div>
      <div class="duty-detail">
        <dt class="duty-detail-label">Assignee</dt>
        <dd class="duty-detail-value"><%= duty.assignee_name || "Unassigned" %></dd>
      </div>
      <div class="duty-detail">
        <dt class="duty-detail-label">Date</dt>
        <dd class="duty-detail-value"><time datetime="<%= toDateValue(duty.start_time) %>"><%= fmtDate(duty.start_time) %></time></dd>
      </div>
      <div class="duty-detail">
        <dt class="duty-detail-label">Time</dt>
        <dd class="duty-detail-value"><%= fmtTime(duty.start_time) %> &ndash; <%= fmtTime(duty.end_time) %></dd>
      </div>
      <div class="duty-detail">
        <dt class="duty-detail-label">Students</dt>
        <dd class="duty-detail-value"><%= duty.student_count %> assigned</dd>
      </div>
    </dl>
    <div class="duty-card-actions">
      <button type="button" class="btn btn-sm btn-outline-secondary duty-edit-btn"
              data-bs-toggle="modal" data-bs-target="#edit-duty-modal"
              data-duty-id="<%= duty.id %>"
              data-duty-title="<%= duty.title %>"
              data-duty-area="<%= duty.area %>"
              data-duty-status="<%= duty.status %>"
              data-duty-assignee="<%= duty.assignee_name || "" %>"
              data-duty-start="<%= toInputValue(duty.start_time) %>"
              data-duty-end="<%= toInputValue(duty.end_time) %>"
              data-duty-students="<%= duty.student_count %>"
              aria-label="Edit <%= duty.title %>">
        <i class="bi bi-pencil" aria-hidden="true"></i>
        Edit
      </button>
    </div>
  </article>
  <% }); %>
</div>
<% } else if (!hasAnyDuties) { %>
<div class="card duty-empty-card">
  <div class="empty-state">
    <i class="bi bi-calendar-week fs-1 text-muted mb-3" aria-hidden="true"></i>
    <h3>No duties exist yet</h3>
    <p class="text-muted mb-0">Once duties are scheduled they will be listed here.</p>
  </div>
</div>
<% } else { %>
<div class="card duty-empty-card">
  <div class="empty-state">
    <i class="bi bi-funnel fs-1 text-muted mb-3" aria-hidden="true"></i>
    <h3>No duty matches the current filters</h3>
    <p class="text-muted">There are <%= counts.all %> duties in total, but none of them match this search and date range.</p>
    <a class="btn btn-secondary mt-3" href="/csdl/duty-management" id="clear-duty-filters-empty">Clear filters</a>
  </div>
</div>
<% } %>

<!-- Pagination -->
<% if (pageCount > 1) { %>
<nav class="duty-pagination" aria-label="Duty list pages">
  <ul class="pagination">
    <% if (page <= 1) { %>
    <li class="page-item disabled">
      <a class="page-link" href="<%= buildUrl({ page: 1 }) %>" rel="prev"
         aria-disabled="true" tabindex="-1">Previous</a>
    </li>
    <% } else { %>
    <li class="page-item">
      <a class="page-link" href="<%= buildUrl({ page: page - 1 }) %>" rel="prev">Previous</a>
    </li>
    <% } %>
    <% for (let pageNumber = 1; pageNumber <= pageCount; pageNumber += 1) { %>
    <% if (pageNumber === page) { %>
    <li class="page-item active">
      <a class="page-link" href="<%= buildUrl({ page: pageNumber }) %>" aria-current="page"><%= pageNumber %></a>
    </li>
    <% } else { %>
    <li class="page-item">
      <a class="page-link" href="<%= buildUrl({ page: pageNumber }) %>"><%= pageNumber %></a>
    </li>
    <% } %>
    <% } %>
    <% if (page >= pageCount) { %>
    <li class="page-item disabled">
      <a class="page-link" href="<%= buildUrl({ page: pageCount }) %>" rel="next"
         aria-disabled="true" tabindex="-1">Next</a>
    </li>
    <% } else { %>
    <li class="page-item">
      <a class="page-link" href="<%= buildUrl({ page: page + 1 }) %>" rel="next">Next</a>
    </li>
    <% } %>
  </ul>
</nav>
<% } %>

<!-- Create duty modal. The form is presentational: saving is not enabled. -->
<div class="modal fade" id="create-duty-modal" tabindex="-1" aria-labelledby="create-duty-modal-label" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="create-duty-modal-label">Create duty</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form class="duty-form" id="create-duty-form">
          <div class="duty-form-grid">
            <div class="duty-form-field">
              <label class="form-label" for="create-duty-title">Title <span class="duty-required" aria-hidden="true">*</span></label>
              <input type="text" class="form-control" id="create-duty-title" name="title" required
                     aria-required="true" autocomplete="off">
            </div>
            <div class="duty-form-field">
              <label class="form-label" for="create-duty-area">Area <span class="duty-required" aria-hidden="true">*</span></label>
              <input type="text" class="form-control" id="create-duty-area" name="area" required
                     aria-required="true" autocomplete="off">
            </div>
            <div class="duty-form-field">
              <label class="form-label" for="create-duty-assignee">Assignee</label>
              <input type="text" class="form-control" id="create-duty-assignee" name="assignee" autocomplete="off">
            </div>
            <div class="duty-form-field">
              <label class="form-label" for="create-duty-status">Status</label>
              <select class="form-select" id="create-duty-status" name="status">
                <% STATUSES.forEach(function (status) { %>
                <option value="<%= status %>"><%= titleCase(status) %></option>
                <% }); %>
              </select>
            </div>
            <div class="duty-form-field">
              <label class="form-label" for="create-duty-start">Starts <span class="duty-required" aria-hidden="true">*</span></label>
              <input type="datetime-local" class="form-control" id="create-duty-start" name="start" required
                     aria-required="true">
            </div>
            <div class="duty-form-field">
              <label class="form-label" for="create-duty-end">Ends</label>
              <input type="datetime-local" class="form-control" id="create-duty-end" name="end">
            </div>
          </div>
        </form>
        <p class="duty-form-note">
          <i class="bi bi-info-circle" aria-hidden="true"></i>
          Saving is not enabled in this release — this form is shown for layout review only and writes nothing.
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="create-duty-save" disabled>Save duty</button>
      </div>
    </div>
  </div>
</div>

<!-- Edit duty modal, pre-filled with the selected duty. -->
<div class="modal fade" id="edit-duty-modal" tabindex="-1" aria-labelledby="edit-duty-modal-label" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="edit-duty-modal-label">Edit duty</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form class="duty-form" id="edit-duty-form">
          <div class="duty-form-grid">
            <div class="duty-form-field">
              <label class="form-label" for="edit-duty-title">Title <span class="duty-required" aria-hidden="true">*</span></label>
              <input type="text" class="form-control" id="edit-duty-title" name="title" required
                     aria-required="true" autocomplete="off">
            </div>
            <div class="duty-form-field">
              <label class="form-label" for="edit-duty-area">Area <span class="duty-required" aria-hidden="true">*</span></label>
              <input type="text" class="form-control" id="edit-duty-area" name="area" required
                     aria-required="true" autocomplete="off">
            </div>
            <div class="duty-form-field">
              <label class="form-label" for="edit-duty-assignee">Assignee</label>
              <input type="text" class="form-control" id="edit-duty-assignee" name="assignee" autocomplete="off">
            </div>
            <div class="duty-form-field">
              <label class="form-label" for="edit-duty-status">Status</label>
              <select class="form-select" id="edit-duty-status" name="status">
                <% STATUSES.forEach(function (status) { %>
                <option value="<%= status %>"><%= titleCase(status) %></option>
                <% }); %>
              </select>
            </div>
            <div class="duty-form-field">
              <label class="form-label" for="edit-duty-start">Starts <span class="duty-required" aria-hidden="true">*</span></label>
              <input type="datetime-local" class="form-control" id="edit-duty-start" name="start" required
                     aria-required="true">
            </div>
            <div class="duty-form-field">
              <label class="form-label" for="edit-duty-end">Ends</label>
              <input type="datetime-local" class="form-control" id="edit-duty-end" name="end">
            </div>
          </div>
        </form>
        <p class="duty-form-note">
          <i class="bi bi-info-circle" aria-hidden="true"></i>
          Saving is not enabled in this release — this form is shown for layout review only and writes nothing.
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="edit-duty-save" disabled>Save changes</button>
      </div>
    </div>
  </div>
</div>
