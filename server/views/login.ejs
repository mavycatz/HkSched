<%- include("partials/head", { title: "Sign in" }) %>
<%# Preload the hero background so the login screen paints without a flash. %>
<link rel="preload" as="image" href="/img/bg.png">
<link rel="preload" as="image" href="/img/cdslweb.png">

<div class="login-page">
  <div class="login-wrap">
    <div class="login-content">
      <img class="login-logo" src="/img/logo.png" alt="HK Scholastics logo" width="110" height="110">
      <h1 class="login-title">HK Scholastics</h1>
      <p class="login-subtitle">Duty Scheduling Management System</p>

      <section class="login-card" aria-labelledby="login-heading">
      <h2 id="login-heading" class="card-welcome">Welcome Back!</h2>
      <p class="card-sub">Log in to your account</p>

      <% if (error) { %>
      <div class="form-alert" role="alert"><%= error %></div>
      <% } %>

      <form method="post" action="/login" novalidate id="login-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-field">
          <label class="form-label" for="identifier">Username</label>
          <div class="field">
            <span class="field-icon" aria-hidden="true">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/></svg>
            </span>
            <input
              type="text"
              id="identifier"
              name="identifier"
              placeholder="Username"
              value="<%= identifier %>"
              autocomplete="username"
              autofocus
              aria-describedby="identifier-error"
              <%= fieldErrors && fieldErrors.identifier ? 'aria-invalid="true"' : "" %>
            >
          </div>
          <p class="field-error" id="identifier-error" role="alert"><%= fieldErrors && fieldErrors.identifier ? fieldErrors.identifier[0] : "" %></p>
        </div>

        <div class="form-field">
          <label class="form-label" for="password">Password</label>
          <div class="field">
            <span class="field-icon" aria-hidden="true">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4.5" y="10.5" width="15" height="9.5" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/></svg>
            </span>
            <input
              type="password"
              id="password"
              name="password"
              placeholder="Password"
              autocomplete="current-password"
              aria-describedby="password-error"
              <%= fieldErrors && fieldErrors.password ? 'aria-invalid="true"' : "" %>
            >
            <button type="button" class="eye-toggle" id="eye-toggle" aria-label="Show password" aria-pressed="false" aria-controls="password">
              <svg class="eye-open" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
              <svg class="eye-closed is-hidden" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l16 16"/><path d="M9.9 5.7A10.6 10.6 0 0 1 12 5.5c6.5 0 10 6.5 10 6.5a17.9 17.9 0 0 1-3.6 4.3M6.6 7.7A17.6 17.6 0 0 0 2 12s3.5 6.5 10 6.5a10.9 10.9 0 0 0 4-.75"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>
            </button>
          </div>
          <p class="field-error" id="password-error" role="alert"><%= fieldErrors && fieldErrors.password ? fieldErrors.password[0] : "" %></p>
        </div>

        <div class="remember-row">
          <label class="remember-label" for="remember">
            <input type="checkbox" id="remember" name="remember" value="on">
            Remember me
          </label>
          <a class="forgot-link" href="/forgot-password">Forgot Password?</a>
        </div>

        <button class="login-btn" type="submit" id="login-button">
          <span class="btn-label">Log in</span>
          <span class="spinner" aria-hidden="true"></span>
        </button>

        <p class="waking-notice" id="waking-notice" role="status">Server is waking up, please wait...</p>
      </form>
    </section>
    </div>
  </div>
</div>

<script src="/js/login.js?v=<%= typeof assetVersion !== "undefined" ? assetVersion : "0" %>" defer></script>
</body>
</html>
