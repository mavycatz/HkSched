# HK Duty server environment variables — copy to .env and fill in.
# NEVER commit a real .env file.

# PostgreSQL connection string (Render: use the INTERNAL database URL)
DATABASE_URL=postgresql://user:password@localhost:5432/hkduty_dev

# Secret used to sign session cookies (Render: generateValue: true)
SESSION_SECRET=change-me-to-a-long-random-string

# production | development | test
NODE_ENV=development

# Public base URL of the deployed site (https://hkduty-app.onrender.com)
APP_BASE_URL=http://localhost:3000

# Port the server listens on (Render provides this)
PORT=3000
